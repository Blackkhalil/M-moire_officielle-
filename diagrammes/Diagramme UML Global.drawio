      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Utilisateur {\n        +int id\n        +string nom\n        +string email\n        +string mot_de_passe\n        +seConnecter()\n        +seDeconnecter()\n    }\n\n    class Organisateur {\n        +gererEditions()\n        +gererProjets()\n        +validerRapport()\n        +validerPresentation()\n        +gererGroupesSalles()\n    }\n\n    class Etudiant {\n        +soumettreProjet()\n        +soumettreRapport()\n        +soumettrePresentation()\n        +suivreSoumissions()\n    }\n\n    class Visiteur {\n        +voirProjectParSalle()\n        +commenterProject()\n    }\n\n    Utilisateur &lt;|-- Organisateur\n    Utilisateur &lt;|-- Etudiant\n    Utilisateur &lt;|-- Visiteur\n\n    class Edition {\n        +int id\n        +int annee\n        +string description\n        +date date_debut\n        +date date_fin\n    }\n\n    class Projet {\n        +int id\n        +string nom\n        +string description\n        +string categorie\n    }\n\n    Edition \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Projet\n\n    class Soumission {\n        &lt;&lt;abstraite&gt;&gt;\n        +date_soumission: Date\n        +fichier: String\n        +etat_validation: String\n    }\n\n    class Rapport\n    class Presentation\n\n    Soumission &lt;|-- Rapport\n    Soumission &lt;|-- Presentation\n\n    Projet \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Soumission\n\n    class Commentaire {\n        +commentaire: String\n        +date_creation: Date\n    }\n\n    Projet \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Commentaire\n    Utilisateur \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Commentaire\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiFEdMb5i-VUWcbVcKgM-158">
